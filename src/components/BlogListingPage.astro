---
import Icon from '@/components/Icon.astro';
import type { BlogPost } from '@/lib/blogPagination';
import { getBlogPageHref } from '@/lib/blogPagination';

interface Props {
  pagePosts: BlogPost[];
  allPosts: BlogPost[];
  currentPage: number;
  totalPages: number;
}

const { pagePosts, allPosts, currentPage, totalPages } = Astro.props;
const isFirstPage = currentPage === 1;
const featured = isFirstPage ? pagePosts.find((post) => post.data.featured) ?? pagePosts[0] : undefined;
const gridPosts = featured ? pagePosts.filter((post) => post.id !== featured.id) : pagePosts;
const searchPosts = allPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  readingTime: post.data.readingTime,
  href: `/blog/${post.id}`,
  keywords: [
    post.data.title,
    post.data.description,
    post.data.category,
    post.data.readingTime,
    post.id.replace(/-/g, ' '),
  ].join(' ').toLowerCase(),
}));
---

<section class="section blog-section">
  <div class="container" data-blog-search-root>
    <div class="blog-search-panel" data-reveal>
      <form class="blog-search" role="search" data-blog-search-form>
        <label for="blog-search-input">
          <Icon name="search" size={18} />
          <span>Search articles</span>
        </label>
        <div class="blog-search-input-shell">
          <div class="blog-search-input-wrap">
            <input
              id="blog-search-input"
              type="search"
              name="q"
              placeholder="Search by title, topic, or workflow"
              autocomplete="off"
              aria-autocomplete="list"
              aria-controls="blog-live-suggestions"
              aria-expanded="false"
              data-blog-search-input
            />
            <span class="blog-search-loader" aria-hidden="true" hidden data-blog-search-loader></span>
            <button type="button" data-blog-search-clear hidden>Clear</button>
          </div>
          <div id="blog-live-suggestions" class="blog-search-suggestions" role="listbox" hidden data-blog-search-suggestions>
            <div class="blog-search-suggestions-head">
              <span data-blog-suggestions-title>Suggestions</span>
              <small data-blog-suggestions-meta></small>
            </div>
            <div class="blog-search-suggestion-list" data-blog-suggestion-list></div>
          </div>
        </div>
      </form>
      <div class="blog-search-count" aria-live="polite" data-blog-search-count>
        Showing {pagePosts.length} of {allPosts.length} articles
      </div>
    </div>

    <div data-blog-browse>
      {featured && (
        <a class="featured-post" href={`/blog/${featured.id}`} data-reveal>
          <div class="featured-post-art">
            <span><Icon name="file-text" size={32} /></span>
            <div class="art-lines"><i></i><i></i><i></i><i></i></div>
            <div class="art-badge">Featured guide</div>
          </div>
          <div class="featured-post-copy">
            <div class="post-meta"><span>{featured.data.category}</span><span>{featured.data.readingTime}</span></div>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <small>Read article <Icon name="arrow-right" size={16} /></small>
          </div>
        </a>
      )}

      <div class="blog-grid">
        {gridPosts.map((post) => (
          <article class="post-card" data-reveal>
            <div class="post-card-art"><Icon name="quote" size={27} /></div>
            <div class="post-meta"><span>{post.data.category}</span><span>{post.data.readingTime}</span></div>
            <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <a class="text-link" href={`/blog/${post.id}`}>Read article <Icon name="arrow-right" size={15} /></a>
          </article>
        ))}
      </div>

      {totalPages > 1 && (
        <nav class="blog-pagination" aria-label="Blog pagination">
          <a
            class:list={['blog-page-link', currentPage === 1 && 'is-disabled']}
            href={currentPage === 1 ? undefined : getBlogPageHref(currentPage - 1)}
            aria-disabled={currentPage === 1 ? 'true' : undefined}
          >
            Previous
          </a>
          <div class="blog-page-numbers">
            {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
              <a
                class:list={['blog-page-number', page === currentPage && 'is-current']}
                href={getBlogPageHref(page)}
                aria-current={page === currentPage ? 'page' : undefined}
              >
                {page}
              </a>
            ))}
          </div>
          <a
            class:list={['blog-page-link', currentPage === totalPages && 'is-disabled']}
            href={currentPage === totalPages ? undefined : getBlogPageHref(currentPage + 1)}
            aria-disabled={currentPage === totalPages ? 'true' : undefined}
          >
            Next
          </a>
        </nav>
      )}
    </div>

    <div class="blog-search-results" hidden data-blog-search-results>
      <div class="blog-grid" data-blog-search-grid></div>
      <div class="blog-empty-state" hidden data-blog-empty-state>
        <strong>No matching articles found</strong>
        <p>Try a different RFQ topic, quotation workflow, or procurement keyword.</p>
      </div>
      <nav class="blog-pagination" aria-label="Search results pagination" hidden data-blog-search-pagination>
        <button class="blog-page-link" type="button" data-blog-search-prev>Previous</button>
        <div class="blog-page-numbers" data-blog-search-pages></div>
        <button class="blog-page-link" type="button" data-blog-search-next>Next</button>
      </nav>
    </div>
  </div>
</section>

<script is:inline define:vars={{ searchPosts }}>
  (() => {
    const root = document.querySelector('[data-blog-search-root]');
    if (!root) return;

    const posts = searchPosts;
    const pageSize = 12;
    const suggestionLimit = 6;
    const searchDelay = 130;
    const form = root.querySelector('[data-blog-search-form]');
    const input = root.querySelector('[data-blog-search-input]');
    const clearButton = root.querySelector('[data-blog-search-clear]');
    const loader = root.querySelector('[data-blog-search-loader]');
    const suggestions = root.querySelector('[data-blog-search-suggestions]');
    const suggestionList = root.querySelector('[data-blog-suggestion-list]');
    const suggestionsTitle = root.querySelector('[data-blog-suggestions-title]');
    const suggestionsMeta = root.querySelector('[data-blog-suggestions-meta]');
    const browse = root.querySelector('[data-blog-browse]');
    const results = root.querySelector('[data-blog-search-results]');
    const grid = root.querySelector('[data-blog-search-grid]');
    const empty = root.querySelector('[data-blog-empty-state]');
    const count = root.querySelector('[data-blog-search-count]');
    const pager = root.querySelector('[data-blog-search-pagination]');
    const prevButton = root.querySelector('[data-blog-search-prev]');
    const nextButton = root.querySelector('[data-blog-search-next]');
    const pageNumbers = root.querySelector('[data-blog-search-pages]');
    let filteredPosts = [];
    let currentSearchPage = 1;
    let currentSuggestions = [];
    let activeSuggestionIndex = -1;
    let searchTimer;

    const normalize = (value) => value.trim().toLowerCase();
    const escapeHtml = (value) => value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
    const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const clearSuggestionActiveState = () => {
      suggestionList.querySelectorAll('[data-blog-suggestion]').forEach((button) => {
        button.classList.remove('is-active');
        button.setAttribute('aria-selected', 'false');
      });
    };

    const setSuggestionsOpen = (isOpen) => {
      suggestions.hidden = !isOpen;
      input.setAttribute('aria-expanded', String(isOpen));
    };

    const scorePost = (post, query) => {
      if (!query) return 0;
      const words = query.split(/\s+/).filter(Boolean);
      let score = 0;
      const title = post.title.toLowerCase();
      const description = post.description.toLowerCase();
      const category = post.category.toLowerCase();
      const id = post.id.replace(/-/g, ' ').toLowerCase();

      if (title === query) score += 120;
      if (title.startsWith(query)) score += 90;
      if (title.includes(query)) score += 70;
      if (category.includes(query)) score += 45;
      if (description.includes(query)) score += 25;
      if (id.includes(query)) score += 18;

      words.forEach((word) => {
        if (title.includes(word)) score += 12;
        if (category.includes(word)) score += 8;
        if (description.includes(word)) score += 5;
      });

      return score;
    };

    const getMatches = (query) => posts
      .map((post) => ({ ...post, score: scorePost(post, query) }))
      .filter((post) => post.score > 0)
      .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title));

    const highlightMatch = (text, query) => {
      const term = query.split(/\s+/).filter(Boolean).sort((a, b) => b.length - a.length)[0];
      const safeText = escapeHtml(text);
      if (!term) return safeText;
      return safeText.replace(new RegExp(`(${escapeRegExp(escapeHtml(term))})`, 'ig'), '<mark>$1</mark>');
    };

    const renderCard = (post, index = 0) => {
      const article = document.createElement('article');
      article.className = 'post-card';
      article.style.setProperty('--search-card-delay', `${Math.min(index, 11) * 42}ms`);

      const art = document.createElement('div');
      art.className = 'post-card-art';
      art.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h3c0 3-2 5-4 5v3zM14 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h3c0 3-2 5-4 5v3z"/></svg>';

      const meta = document.createElement('div');
      meta.className = 'post-meta';
      const category = document.createElement('span');
      category.textContent = post.category;
      const readingTime = document.createElement('span');
      readingTime.textContent = post.readingTime;
      meta.append(category, readingTime);

      const title = document.createElement('h2');
      const titleLink = document.createElement('a');
      titleLink.href = post.href;
      titleLink.textContent = post.title;
      title.append(titleLink);

      const description = document.createElement('p');
      description.textContent = post.description;

      const link = document.createElement('a');
      link.className = 'text-link';
      link.href = post.href;
      link.textContent = 'Read article';

      article.append(art, meta, title, description, link);
      return article;
    };

    const renderSuggestions = (query) => {
      currentSuggestions = filteredPosts.slice(0, suggestionLimit);
      activeSuggestionIndex = -1;
      suggestionList.replaceChildren();
      suggestionsTitle.textContent = filteredPosts.length ? 'Suggestions' : 'No suggestions';
      suggestionsMeta.textContent = query ? `${filteredPosts.length} match${filteredPosts.length === 1 ? '' : 'es'}` : '';

      if (!query || currentSuggestions.length === 0) {
        setSuggestionsOpen(Boolean(query));
        return;
      }

      currentSuggestions.forEach((post, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'blog-search-suggestion';
        button.setAttribute('role', 'option');
        button.setAttribute('aria-selected', 'false');
        button.setAttribute('data-blog-suggestion', '');
        button.style.setProperty('--suggestion-delay', `${index * 34}ms`);
        button.innerHTML = `
          <span class="blog-search-suggestion-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <span class="blog-search-suggestion-copy">
            <strong>${highlightMatch(post.title, query)}</strong>
            <small>${escapeHtml(post.category)} · ${escapeHtml(post.readingTime)}</small>
          </span>
        `;
        button.addEventListener('click', () => {
          input.value = post.title;
          filteredPosts = [post, ...posts.filter((item) => item.id !== post.id && scorePost(item, post.title.toLowerCase()) > 0)];
          currentSearchPage = 1;
          setSuggestionsOpen(false);
          clearButton.hidden = false;
          browse.hidden = true;
          results.hidden = false;
          renderSearchResults();
          input.focus();
        });
        suggestionList.append(button);
      });

      setSuggestionsOpen(true);
    };

    const renderSearchPageButtons = (totalPages) => {
      pageNumbers.replaceChildren();
      for (let page = 1; page <= totalPages; page += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `blog-page-number${page === currentSearchPage ? ' is-current' : ''}`;
        button.textContent = String(page);
        button.setAttribute('aria-label', `Search results page ${page}`);
        if (page === currentSearchPage) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => {
          currentSearchPage = page;
          renderSearchResults();
        });
        pageNumbers.append(button);
      }
    };

    const renderSearchResults = () => {
      const totalPages = Math.max(1, Math.ceil(filteredPosts.length / pageSize));
      currentSearchPage = Math.min(currentSearchPage, totalPages);
      const start = (currentSearchPage - 1) * pageSize;
      const pagePosts = filteredPosts.slice(start, start + pageSize);

      grid.replaceChildren(...pagePosts.map(renderCard));
      empty.hidden = filteredPosts.length !== 0;
      pager.hidden = filteredPosts.length <= pageSize;
      prevButton.disabled = currentSearchPage === 1;
      nextButton.disabled = currentSearchPage === totalPages;
      renderSearchPageButtons(totalPages);
      count.textContent = `${filteredPosts.length} matching ${filteredPosts.length === 1 ? 'article' : 'articles'}`;
    };

    const finishSearch = () => {
      const query = normalize(input.value);
      root.classList.remove('is-searching');
      loader.hidden = true;

      if (!query) {
        results.hidden = true;
        browse.hidden = false;
        clearButton.hidden = true;
        setSuggestionsOpen(false);
        count.textContent = `Showing ${root.querySelectorAll('[data-blog-browse] .post-card').length + root.querySelectorAll('[data-blog-browse] .featured-post').length} of ${posts.length} articles`;
        return;
      }

      filteredPosts = getMatches(query);
      currentSearchPage = 1;
      browse.hidden = true;
      results.hidden = false;
      clearButton.hidden = false;
      renderSearchResults();
      renderSuggestions(query);
    };

    const updateSearch = () => {
      window.clearTimeout(searchTimer);
      const query = normalize(input.value);
      if (!query) {
        finishSearch();
        return;
      }

      root.classList.add('is-searching');
      loader.hidden = false;
      searchTimer = window.setTimeout(finishSearch, searchDelay);
    };

    const moveSuggestionFocus = (direction) => {
      if (suggestions.hidden || currentSuggestions.length === 0) return;
      activeSuggestionIndex = (activeSuggestionIndex + direction + currentSuggestions.length) % currentSuggestions.length;
      clearSuggestionActiveState();
      const active = suggestionList.querySelectorAll('[data-blog-suggestion]')[activeSuggestionIndex];
      active?.classList.add('is-active');
      active?.setAttribute('aria-selected', 'true');
      active?.scrollIntoView({ block: 'nearest' });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      setSuggestionsOpen(false);
    });
    input.addEventListener('input', updateSearch);
    input.addEventListener('focus', () => {
      const query = normalize(input.value);
      if (query && currentSuggestions.length) setSuggestionsOpen(true);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        moveSuggestionFocus(1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        moveSuggestionFocus(-1);
      } else if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
        event.preventDefault();
        suggestionList.querySelectorAll('[data-blog-suggestion]')[activeSuggestionIndex]?.click();
      } else if (event.key === 'Escape') {
        setSuggestionsOpen(false);
      }
    });
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) setSuggestionsOpen(false);
    });
    clearButton.addEventListener('click', () => {
      input.value = '';
      input.focus();
      updateSearch();
    });
    prevButton.addEventListener('click', () => {
      if (currentSearchPage > 1) {
        currentSearchPage -= 1;
        renderSearchResults();
      }
    });
    nextButton.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredPosts.length / pageSize);
      if (currentSearchPage < totalPages) {
        currentSearchPage += 1;
        renderSearchResults();
      }
    });
  })();
</script>
