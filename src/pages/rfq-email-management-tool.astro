---
import RawLandingLayout from '@/layouts/RawLandingLayout.astro';
import LandingPage from '@/react/landing-pages/rfq-email-management-tool/App';
import { buildLandingSchemas, getLandingSeo } from '@/data/landingSeo';
import '@/react/landing-pages/rfq-email-management-tool/index.css';

const seo = getLandingSeo('rfq-email-management-tool');
const schemas = buildLandingSchemas(seo);
---
<RawLandingLayout title={seo.title} description={seo.description} canonical="/rfq-email-management-tool" jsonLd={schemas}>
  <LandingPage client:load />
</RawLandingLayout>
