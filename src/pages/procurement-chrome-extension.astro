---
import RawLandingLayout from '@/layouts/RawLandingLayout.astro';
import LandingPage from '@/react/landing-pages/procurement-chrome-extension/App';
import { buildLandingSchemas, getLandingSeo } from '@/data/landingSeo';
import '@/react/landing-pages/procurement-chrome-extension/index.css';

const seo = getLandingSeo('procurement-chrome-extension');
const schemas = buildLandingSchemas(seo);
---
<RawLandingLayout title={seo.title} description={seo.description} canonical="/procurement-chrome-extension" jsonLd={schemas}>
  <LandingPage client:load />
</RawLandingLayout>
